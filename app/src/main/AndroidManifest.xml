<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".CodeIslandApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodeIsland"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CodeIsland">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              ★ 应用快捷方式（侧键菜单里的「捕获屏幕」「设置」）。
              三星的「打开应用程序或执行应用内功能」会读这里的 meta-data，
              把 shortcuts.xml 里声明的条目列出来。
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- 快捷方式点进来的两种动作 -->
            <intent-filter>
                <action android:name="com.codeisland.action.CAPTURE" />
                <action android:name="com.codeisland.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          入口 1：桌面快捷方式 / 长按图标 / 其它 App 调起。
          桌面「快捷方式」小组件指向的就是下面这个 action。
        -->
        <activity
            android:name=".ui.CaptureShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CodeIsland.Transparent">
            <intent-filter>
                <action android:name="com.codeisland.action.CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          无障碍服务：只用来做「截屏」和「双击手势」两件事。
          没有配置任何窗口事件监听（typeWindowStateChanged 等），
          不会去读你屏幕上的其它内容。
        -->
        <service
            android:name=".capture.CaptureAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 入口 2：快捷设置磁贴 -->
        <service
            android:name=".entry.TileCaptureService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- 入口 3：悬浮按钮（可选，默认关闭） -->
        <service
            android:name=".entry.FloatingButtonService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_entry_for_screenshot_capture" />
        </service>

        <!-- 通知上的「复制 / 收起」按钮 -->
        <receiver
            android:name=".island.IslandActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.codeisland.action.ISLAND_COPY" />
                <action android:name="com.codeisland.action.ISLAND_DISMISS" />
            </intent-filter>
        </receiver>

        <!-- 保活/常驻用的通知渠道由代码创建，这里不需要声明 -->

    </application>

</manifest>
