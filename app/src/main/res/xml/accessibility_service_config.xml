<?xml version="1.0" encoding="utf-8"?>
<!--
  无障碍服务配置。

  ★ 关于 canTakeScreenshot 的一个实测教训（2026-09-22，SM-S9110 / Android 16）：

    之前这份配置里写了 android:canPerformGestures="true"，结果服务在系统的
    "已绑定服务" 列表里出现了，但 onServiceConnected() **始终没有被回调**——
    服务等于没活过来。

    原因：canPerformGestures 会让系统以"手势服务"的方式去初始化这个服务，
    而我们并没有真正实现手势分发，配置和实现对不上，系统就卡在绑定阶段。

    现在改成只声明 we 真正用到的东西：
      canRetrieveWindowContent = true  （takeScreenshot 的前置要求）
      canTakeScreenshot        = true  （截屏，不弹录屏授权框）

    「双击屏幕触发」这个功能因此暂时下线了。要恢复它，得改成用
    dispatchGesture 或另外走一个独立的服务，不能和截屏混在一起。

  accessibilityEventTypes：必须非空，否则配置不合法。
  这里声明窗口状态变化是"占位"，实际运行时代码不会再覆盖它
  （旧版本会在 onServiceConnected 里改 serviceInfo，那个做法已删除，
   见 CaptureAccessibilityService 的注释）。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/a11y_service_description"
    android:notificationTimeout="100"
    android:summary="@string/a11y_service_summary" />
